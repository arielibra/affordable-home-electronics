{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Cloudflare Workers deploy config for Affordable Home Electronics.
  //
  // The D1 database id below is filled in and points at the real database.
  // It is an address, not a secret. The account id and API token live in
  // GitHub secrets and never in this file.

  "name": "affordable-home-electronics",

  // The Worker entry: `vite build` emits dist/server/server.js, which exports
  // `default { fetch }`.
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static files in dist/client serve directly; anything else, including "/",
  // falls through to the server-rendering Worker. Do not set run_worker_first.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // The catalog, carts, orders and quote requests.
  // Schema and seed data live in ./migrations and are applied with
  // `wrangler d1 migrations apply affordable-home-electronics-db --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affordable-home-electronics-db",
      "database_id": "ff2529fe-4ff5-42c4-9b0d-2c37185deeda",
      "migrations_dir": "migrations"
    }
  ],

  // Product photography uploaded from the admin page, plus copies of
  // manufacturer images. Served back through /media/<key> by the Worker, so
  // the bucket itself stays private.
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "affordable-home-electronics-media"
    }
  ],

  // Daily at 14:00 UTC (10am New York in summer, 9am in winter): the review
  // follow-up email for orders that shipped two weeks earlier.
  "triggers": { "crons": ["0 14 * * *"] },

  "vars": { "HF_ENV": "production", "APP_SLUG": "affordable-home-electronics" }
}
