{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Cloudflare Workers deploy config for Affordable Home Electronics.
  //
  // Two values must be filled in before the first deploy:
  //   1. "database_id" below, from the D1 database you create in the Cloudflare
  //      dashboard (Storage & Databases -> D1 -> Create). Copy the Database ID.
  //   2. Nothing else. The account id and API token live in GitHub secrets,
  //      never in this file.

  "name": "affordable-home-electronics",

  // The Worker entry: `vite build` emits dist/server/server.js, which exports
  // `default { fetch }`.
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static files in dist/client serve directly; anything else, including "/",
  // falls through to the server-rendering Worker. Do not set run_worker_first.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // The catalog, carts, orders and quote requests.
  // Schema and seed data live in ./migrations and are applied with
  // `wrangler d1 migrations apply affordable-home-electronics-db --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affordable-home-electronics-db",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ],

  "vars": { "HF_ENV": "production", "APP_SLUG": "affordable-home-electronics" }
}
